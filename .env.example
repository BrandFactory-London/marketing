# Copy to .env.local for local development. Set the same names in Vercel (Preview and Production).

# Neon Postgres, pooled connection string (sslmode=require).
DATABASE_URL=

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Web application) with the Google Drive API enabled.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The only Google account allowed to sign in.
ALLOWED_EMAIL=hello@brandfactorylondon.com

# 32 random bytes, base64, for AES-GCM encryption of stored secrets. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Tests only: the local Postgres used by Vitest integration tests and Playwright.
TEST_DATABASE_URL=postgres://postgres@localhost:5433/bfm_test
